# Ignore CI configuration
.github/

# Ignore temporary files
*.log
*.tmp
*.swp

# Ignore Git files
.git/
.gitignore
.gitattributes

# Ignore build and deployment scripts (if not needed in the container)
scripts/

# Ignore Node.js dependencies (installed fresh in the image)
node_modules/
package-lock.json
yarn.lock

# Ignore IDE/editor configuration files
*.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Ignore OS-generated files
.DS_Store
Thumbs.db

# Ignore Docker-specific files
Dockerfile
docker-compose.yaml

# Ignore backups
*.bak
*.old

# Ignore miscellaneous files
*.tar.gz
*.zip
*.backup
*.log
